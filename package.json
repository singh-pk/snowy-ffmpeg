{
  "name": "@snowy-media/ffmpeg",
  "version": "0.1.0",
  "description": "FFmpeg 9 compiled to WebAssembly as small, lazily loaded modules for playing and editing video in the browser",
  "keywords": [
    "audio",
    "decoder",
    "demuxer",
    "ffmpeg",
    "video",
    "wasm",
    "webassembly",
    "webcodecs"
  ],
  "homepage": "https://github.com/singh-pk/snowy-ffmpeg#readme",
  "bugs": "https://github.com/singh-pk/snowy-ffmpeg/issues",
  "license": "LGPL-2.1-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singh-pk/snowy-ffmpeg.git"
  },
  "files": [
    "dist/*/*.js",
    "dist/*/*.d.ts",
    "dist/*/*.wasm",
    "dist/licenses",
    "NOTICE",
    "LICENSES",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./audio-ext": {
      "types": "./dist/audio-ext/index.d.ts",
      "default": "./dist/audio-ext/index.js"
    },
    "./video": {
      "types": "./dist/video/index.d.ts",
      "default": "./dist/video/index.js"
    },
    "./video-ext": {
      "types": "./dist/video-ext/index.d.ts",
      "default": "./dist/video-ext/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "docker buildx build --target dist --output type=local,dest=dist . && bun scripts/gen-dts.ts",
    "test": "bun test",
    "bench": "bun bench/run.ts",
    "bench:audio": "bun bench/decode.ts",
    "bench:video": "bun bench/video.ts",
    "fixtures": "bun scripts/gen-fixtures.ts",
    "settings": "bun scripts/settings.ts",
    "format": "oxfmt && clang-format -i src/*.c src/*.h",
    "format:check": "oxfmt --check && clang-format --dry-run --Werror src/*.c src/*.h",
    "lint": "oxlint --type-aware --max-warnings 0 --report-unused-disable-directives-severity error",
    "lint:md": "markdownlint-cli2",
    "lint:unused": "knip",
    "typecheck": "tsc",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run lint:md && bun run lint:unused"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@wasm-fmt/clang-format": "23.1.1",
    "knip": "6.41.0",
    "libav.js": "6.10.9",
    "markdownlint-cli2": "0.23.3",
    "mediabunny": "1.61.6",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
