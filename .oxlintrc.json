{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "es2024": true,
    "browser": true,
    "worker": true
  },
  "ignorePatterns": [
    "dist/**",
    "bench/variants/**",
    "bench/media/**",
    "test/fixtures/**",
    "bench/results/**"
  ],
  "rules": {
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-console": "off",
    "import/no-unassigned-import": "off",
    "import/no-absolute-path": "off",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "unicorn/prefer-node-protocol": "error",
    "no-underscore-dangle": "off",
    "no-await-in-loop": "off",
    "unicorn/require-post-message-target-origin": "off",
    "repo/blank-line-around-blocks": "error",
    "repo/no-access-modifiers": "error",
    "repo/no-await-assertion": "error",
    "repo/no-classes": "error",
    "repo/no-module-let": "error",
    "repo/no-nested-await": "error",
    "repo/no-promise-chains": "error",
    "repo/no-set-interval": "error"
  },
  "jsPlugins": [
    {
      "name": "repo",
      "specifier": "./tooling/oxlint-rules/index.js"
    }
  ],
  "overrides": [
    {
      "files": ["src/io.js"],
      "globals": {
        "addToLibrary": "readonly",
        "Module": "readonly"
      }
    }
  ]
}
