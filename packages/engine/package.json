{
  "name": "@snowy-media/engine",
  "version": "0.0.0",
  "private": true,
  "description": "The playback pipeline of Snowy: demuxing, decoding, an audio clock and WebGPU rendering in workers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singh-pk/snowy-media.git",
    "directory": "packages/engine"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test",
    "bench": "bun bench/run.ts",
    "fixtures": "bun scripts/gen-fixtures.ts",
