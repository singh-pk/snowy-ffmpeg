{
  "name": "@snowy-media/engine",
  "version": "0.0.0",
  "description": "The playback pipeline of Snowy: demuxing, decoding, an audio clock and WebGPU rendering in workers",
  "keywords": [
    "audio",
    "media",
    "player",
    "video",
    "webcodecs",
    "webgpu",
    "worker"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singh-pk/snowy-media.git",
    "directory": "packages/engine"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test",
    "bench": "bun bench/run.ts",
    "fixtures": "bun scripts/gen-fixtures.ts",
    "typecheck": "bun --bun tsc && bun --bun tsc -p tsconfig.worker.json && bun --bun tsc -p tsconfig.worklet.json"
  },
  "dependencies": {
    "@snowy-media/ffmpeg": "workspace:^"
  },
  "devDependencies": {
    "@types/audioworklet": "0.0.100",
    "playwright": "1.64.1"
  }
}
