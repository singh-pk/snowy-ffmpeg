{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts", "tooling/**/*.{ts,js}"]
    },
    "packages/engine": {
      "entry": ["scripts/*.ts", "src/index.ts", "src/*.worker.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
    },
    "packages/ffmpeg": {
      "entry": [
        "scripts/*.ts",
        "bench/variants.ts",
        "bench/*worker.js",
        "bench/adapters/*.js",
        "test/*.worker.js"
      ],
      "project": [
        "scripts/**/*.ts",
        "bench/**/*.{ts,js}",
        "test/**/*.{ts,js}",
        "!test/fixtures/**"
      ],
      "paths": {
        "/test/*": ["./test/*"]
      },
      "ignoreBinaries": ["ffmpeg", "ffprobe"],
      "ignoreDependencies": ["libav.js", "mediabunny"],
      "ignoreUnresolved": ["^/dist/"]
    }
  }
}
